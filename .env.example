# Copy to .env (never commit .env)
SECRET_KEY=change-me-to-a-long-random-string
# Optional: separate key for encrypting credentials (Fernet). Derived from SECRET_KEY if empty.
CREDENTIALS_KEY=
# Optional: server-wide AI key for the AI block (free: https://console.groq.com)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
